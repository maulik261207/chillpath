# Set both values to enable API-backed shipments. Leave unset for seeded demo mode.
VITE_API_BASE_URL=http://localhost:8000
VITE_ORGANIZATION_ID=replace-with-organization-uuid
# Public browser key; restrict it to your site's origins in MapTiler.
VITE_MAPTILER_API_KEY=replace-with-your-maptiler-key
# Used by the overview page to read /v1/telemetry/live.
VITE_LIVE_TELEMETRY_API_KEY=replace-with-your-live-telemetry-key
# Alias accepted by deployments that use the shared ChillPath API key name.
VITE_CHILLPATH_API_KEY=replace-with-your-live-telemetry-key

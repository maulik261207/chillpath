APP_NAME=ChillPath API
ENVIRONMENT=local
# Local hackathon default. CHILLPATH_DB_MODE=sqlite ignores stale PostgreSQL URLs.
DATABASE_MODE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./chillpath.db
# Commercial/PostgreSQL option:
# DATABASE_MODE=postgres
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
API_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
GEOAPIFY_API_KEY=replace-with-your-server-side-key
TOMTOM_API_KEY=replace-with-your-server-side-key
CHILLPATH_API_KEY=replace-with-your-live-telemetry-key

